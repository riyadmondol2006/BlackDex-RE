<?xml version="1.0" encoding="utf-8"?>
<!-- Flat, selectable Material 3 list row: leading app icon, headline + supporting text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.BlackDex.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/list_row_icon"
        android:layout_height="@dimen/list_row_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Example app" />

        <TextView
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="com.example.app" />

        <!-- Non-interactive packer/protection status label; hidden when nothing was detected. -->
        <TextView
            android:id="@+id/protectionChip"
            style="@style/Widget.BlackDex.StatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/chip_bg"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_shield"
            app:drawableTint="?attr/colorOnTertiaryContainer"
            tools:text="Ijiami (爱加密) · VMP"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
